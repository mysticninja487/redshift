{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Redshift",
  "version": "0.5.3",
  "identifier": "app.redshift.player",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Redshift",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: cover: http://cover.localhost; font-src 'self' data: font: http://font.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["flac", "opus", "ogg", "oga", "mp3", "wav", "m4a", "mp4", "aac", "alac", "aif", "aiff"], "name": "Audio file", "description": "Music file", "role": "Viewer" },
      { "ext": ["m3u", "m3u8"], "name": "Playlist", "description": "Playlist", "role": "Viewer" }
    ]
  }
}
